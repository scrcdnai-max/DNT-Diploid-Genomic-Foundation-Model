# glm_biotools image pin — the ONE place the tag lives.
#
# Sourced by the shell runners in preprocess/huggingface_dataset/ (they expose it
# as DOCKER_IMAGE, still env-overridable per run) and readable from Python via
# create_haplotype_dataset / tests that need bgzip+tabix shims. Bump this when
# docker_images/glm_biotools/Dockerfile is rebuilt.
#
# Plain KEY=VALUE lines only (no expansions) so both `source` and a Python
# line parser read it identically.
GLM_BIOTOOLS_IMAGE=glm_biotools:1.2.0
